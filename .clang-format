# Стиль кода WorkWatcher. Применяется: make format / make format-check.
---
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# K&R / Linux: скобка функции на новой строке, у управляющих конструкций — на той же.
BreakBeforeBraces: Linux
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

PointerAlignment: Right
SpaceAfterCStyleCast: false
AlignAfterOpenBracket: Align
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true
AlignEscapedNewlines: Right
BinPackArguments: true
BinPackParameters: true
IndentCaseLabels: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
ReflowComments: false

# Порядок #include: собственный заголовок модуля, системные, проектные.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*>'
    Priority: 1
  - Regex: '^"workwatcher/'
    Priority: 2
  - Regex: '.*'
    Priority: 3
IncludeIsMainRegex: '$'
